# Metin sentezi için en az bir LLM sağlayıcısı önerilir (öncelik: Groq > Ollama > Anthropic).
# Ücretsiz Groq anahtarı: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# İsteğe bağlı ücretli yedek sağlayıcı
ANTHROPIC_API_KEY=

# Ayarlar
REQUEST_TIMEOUT=30
REQUEST_DELAY_MS=800
MAX_CONCURRENT_REQUESTS=4
LOG_LEVEL=INFO